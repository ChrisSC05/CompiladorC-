<Window x:Class="AlphaCompiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpha IDE" Height="600" Width="1000"
        Background="{DynamicResource WindowBackground}" FontFamily="Consolas" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#f3f3f3" />
        <SolidColorBrush x:Key="EditorBackground" Color="White" />
        <SolidColorBrush x:Key="TextColor" Color="Black" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0 0 0 10">
            <TextBlock Text="Alpha IDE"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextColor}" />
            <ToggleButton x:Name="themeToggle" Content="🌙 Tema Oscuro" 
                          Width="140" Height="30" Margin="0,0,10,0"
                          HorizontalAlignment="Right"
                          Checked="ThemeToggle_Checked"
                          Unchecked="ThemeToggle_Unchecked"/>
        </DockPanel>

        <!-- Código con números de línea -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Números de línea -->
            <ScrollViewer Name="lineNumberScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- Números de línea -->
                <TextBlock x:Name="lineNumbers"
                           FontFamily="Consolas"
                           FontSize="14"
                           Padding="10,5,5,5"
                           Background="{DynamicResource EditorBackground}"
                           Foreground="Gray"
                           TextAlignment="Right"
                           Margin="0,-1,0,0"   
                           VerticalAlignment="Top"
                />
            </ScrollViewer>

            <!-- Editor de código -->
            <ScrollViewer Name="codeScrollViewer"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          ScrollChanged="CodeInput_ScrollChanged">
                <TextBox x:Name="codeInput"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Padding="10,5,5,5"
                         Background="{DynamicResource EditorBackground}"
                         Foreground="{DynamicResource TextColor}"
                         FontFamily="Consolas"
                         FontSize="14"
                         BorderThickness="0"
                         VerticalAlignment="Top"
                         TextChanged="CodeInput_TextChanged"/>
            </ScrollViewer>
        </Grid>

        <!-- Botón correr -->
        <Button x:Name="runButton"
                Grid.Row="2"
                Content="▶ Compilar / Correr"
                Height="40" Margin="0,0,0,10"
                Background="#007ACC" Foreground="White"
                FontWeight="Bold" BorderThickness="0"
                Click="RunButton_Click"/>

        <!-- Salida -->
        <GroupBox Header="🪄 Salida"
                  Grid.Row="3"
                  FontWeight="Bold"
                  BorderBrush="#aaa"
                  Background="{DynamicResource EditorBackground}"
                  Foreground="{DynamicResource TextColor}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="outputBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         BorderThickness="0" Padding="10"
                         Background="{DynamicResource EditorBackground}"
                         Foreground="{DynamicResource TextColor}"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>
